From fb0b31dd7e9daee4a1f56cc0082e69c9badd8cf8 Mon Sep 17 00:00:00 2001
From: Anonymous <anonymous@example.com>
Date: Mon, 2 Mar 2026 14:39:47 +0000
Subject: [PATCH 28/56] Traverse prefix in `typeAssumptions` to gather
 qualifier facts

When checking `m1.mul(m2)`, the prover needs `m1.height == 3` to prove
`m2.width == m1.height`. This fact lives in `m1`'s qualified type
(`Matrix with m1.width == 2 && m1.height == 3`), but `typeAssumptions`
for `Atom(m1.height)` only looked at `m1.height`'s own type (`Pos`),
never at the prefix `m1`'s type.

Fix by adding `recPrefix` in `typeAssumptions` that traverses into the
prefix's type assumptions when the root type is a `TermRef` with a
`SingletonType` prefix. Also uncomment `mul` and `transpose` calls in
the matrices2 test.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 .../src/dotty/tools/dotc/qualified_types/ENode.scala     | 9 ++++++++-
 tests/pos-custom-args/qualified-types/matrices2.scala    | 8 ++++----
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/compiler/src/dotty/tools/dotc/qualified_types/ENode.scala b/compiler/src/dotty/tools/dotc/qualified_types/ENode.scala
index 09effc483dcb..468da707aa4b 100644
--- a/compiler/src/dotty/tools/dotc/qualified_types/ENode.scala
+++ b/compiler/src/dotty/tools/dotc/qualified_types/ENode.scala
@@ -580,10 +580,17 @@ object ENode:
         case _ => Nil
 
   private def typeAssumptions(rootTp: SingletonType)(using Context): List[ENode] =
+    def selfify(tp: SingletonType): List[ENode] =
+      if tp frozen_=:= rootTp then Nil
+      else List(OpApply(ENode.Op.Equal, List(Atom(tp), Atom(rootTp))))
+    def recPrefix(tp: SingletonType): List[ENode] =
+      tp match
+        case TermRef(prefix: SingletonType, _) => termAssumptions(tp) ::: typeAssumptions(prefix)
+        case _ => Nil
     def rec(tp: Type): List[ENode] =
       tp match
         case QualifiedType(parent, qualifier) => qualifier.body.substEParamRefs(0, List(rootTp)) :: assumptions(qualifier.body) ::: rec(parent)
-        case tp: SingletonType if tp ne rootTp => List(OpApply(ENode.Op.Equal, List(Atom(tp), Atom(rootTp))))
+        case tp: SingletonType => selfify(tp) ::: recPrefix(tp) ::: rec(tp.underlying)
         case tp: TypeProxy => rec(tp.underlying)
         case AndType(tp1, tp2) => rec(tp1) ++ rec(tp2)
         case _ => Nil
